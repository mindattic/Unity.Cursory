*.log
crashlytics-buildid.txt
sysinfo.txt

# dotnet test output
Tests/**/bin/
Tests/**/obj/
TestResults/

# Artifacts: only the committed HTML copies (HOUSE-LAW-12)
/artifacts/*
!/artifacts/*.html
